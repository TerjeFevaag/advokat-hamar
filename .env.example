# ============================================================
# COPY THIS FILE TO .env.local AND FILL IN ALL VALUES
# ============================================================

# --- Anthropic (Claude API for admin dashboard) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Admin Dashboard Password ---
# Simple password to protect the /admin route
ADMIN_PASSWORD=your-secure-password-here

# --- GitHub (for committing content changes + rollback) ---
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=your-github-username
GITHUB_REPO=advh-website
GITHUB_BRANCH=main

# --- Vercel (for deploy status + manual trigger) ---
VERCEL_TOKEN=your-vercel-token-here
VERCEL_PROJECT_ID=your-vercel-project-id-here
VERCEL_TEAM_ID=   # leave blank if personal account

# --- Email (for contact form submissions) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=post@advh.no
